            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "CreateMovieDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "duration": {
            "type": "string",
            "format": "date-span"
          }
        },
        "additionalProperties": false
      },
      "CreateUserDto": {
        "type": "object",
